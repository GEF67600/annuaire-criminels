---
layout: layouts/base.njk
---
<article data-pagefind-body>
  <p><a href="/">&larr; Retour à l'annuaire</a></p>
  <h1>{{ title }}</h1>

  <ul class="meta">
    {% for t in type %}
    <li data-pagefind-filter="Type:{{ t }}">Type : {{ t }}</li>
    {% endfor %}
    {% if pays %}<li data-pagefind-filter="Pays:{{ pays }}">Pays : {{ pays }}</li>{% endif %}
    {% if periode %}<li>Période : {{ periode }}</li>{% endif %}
    {% if victimes %}<li>Victimes (estimation) : {{ victimes }}</li>{% endif %}
    {% if statut %}<li data-pagefind-filter="Statut:{{ statut }}">Statut : {{ statut }}</li>{% endif %}
  </ul>

  <div class="corps">
    {{ content | safe }}
  </div>
</article>
